{
  "name": "lab-knowledge-app",
  "version": "0.1.0-experimental",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4317 --strictPort",
    "build": "pnpm type-check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "type-check": "vue-tsc --build",
    "lint": "eslint .",
    "format": "prettier --write src scripts e2e *.ts *.json",
    "content:check": "node --experimental-strip-types scripts/validate-content.ts",
    "manual:import": "node --experimental-strip-types scripts/import-manual.ts",
    "manual:check": "node --experimental-strip-types scripts/import-manual.ts --check",
    "books:import": "node --experimental-strip-types scripts/import-textbooks.ts",
    "books:check": "node --experimental-strip-types scripts/import-textbooks.ts --check",
    "books-items:extract": "node --experimental-strip-types scripts/extract-book-items.ts",
    "books-items:check": "node --experimental-strip-types scripts/extract-book-items.ts --check",
    "diseases:build": "node --experimental-strip-types scripts/build-diseases.ts",
    "diseases:check": "node --experimental-strip-types scripts/build-diseases.ts --check",
    "check": "pnpm type-check && pnpm lint && pnpm test && pnpm content:check && pnpm manual:check && pnpm books:check && pnpm books-items:check && pnpm diseases:check && vite build"
  },
  "dependencies": {
    "@lucide/vue": "1.46.0",
    "pdfjs-dist": "6.3.289",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.5",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.23.1"
  }
}
