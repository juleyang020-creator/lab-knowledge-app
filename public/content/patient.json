        {
          "id": "section-1",
          "title": "这项检查看什么",
          "claims": [
            {
              "id": "glucose.patient.1",
              "text": "这项检查帮助医生了解你采样时的血糖情况。",
              "provenance": {
                "kind": "model",
                "generatedOn": "2026-09-15"
              },
              "reviewStatus": "unreviewed"
            }
          ]
        },
        {
          "id": "section-2",
          "title": "你需要知道的事",
          "claims": [
            {
              "id": "glucose.patient.2",
              "text": "是否需要空腹及具体准备方式，应以本次医嘱和医院通知为准，不要自行停药。",
              "provenance": {
                "kind": "model",
                "generatedOn": "2026-09-15"
              },
              "reviewStatus": "unreviewed"
            }
          ]
        }
      ]
    },
    {
