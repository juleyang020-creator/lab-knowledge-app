          "id": "section-1",
          "title": "临床参考",
          "claims": [
            {
              "id": "tsh.professional.1",
              "text": "TSH用于甲状腺功能相关评估，具体解读应结合其他甲状腺指标与临床背景。",
              "provenance": {
                "kind": "model",
                "generatedOn": "2026-09-15"
              },
              "reviewStatus": "unreviewed"
            }
          ]
        },
        {
          "id": "section-2",
          "title": "解读局限",
          "claims": [
            {
              "id": "tsh.professional.2",
              "text": "特殊生理状态、用药及其他因素可能改变结果的解释，不能脱离适用条件套用结论。",
              "provenance": {
                "kind": "model",
                "generatedOn": "2026-09-15"
              },
              "reviewStatus": "unreviewed"
            }
          ]
        },
        {
          "id": "section-3",
          "title": "检验原理",
          "claims": [
            {
              "id": "tsh.professional.3",
              "text": "TSH采用化学发光免疫分析（CLIA法）检测，需新鲜血清或血浆。",
              "provenance": {
                "kind": "document",
                "sourceId": "biochem-2025",
                "pdfPage": 231,
                "quote": "采用 CLIA 法检测"
              },
              "reviewStatus": "unreviewed"
            }
          ]
        },
        {
          "id": "section-4",
          "title": "影响因素",
          "claims": [
            {
              "id": "tsh.professional.4",
              "text": "溶血、脂血对TSH测定干扰较大；TSH分泌存在昼夜节律，高峰在清晨2时至4时，低谷在下午5时至6时，一般在清晨起床前采血。",
              "provenance": {
                "kind": "document",
                "sourceId": "biochem-2025",
                "pdfPage": 231,
                "quote": "TSH 的分泌存在昼夜节律"
              },
              "reviewStatus": "unreviewed"
            }
          ]
        }
      ]
    },
    {
      "itemId": "cbc",
      "sections": [
        {
          "id": "section-1",
          "title": "临床参考",
          "claims": [
            {
              "id": "cbc.professional.1",
              "text": "血常规中不同细胞相关指标提供不同信息，需结合计数、分类及必要的其他资料解释。",
